# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Node
node_modules/
npm-debug.log*

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets — never commit these (gate G5 also scans for key patterns)
.env
.env.*
*.pem
*.key

# Build output
dist/
build/
*.docx.tmp

# Converted submissions (keep the Markdown source of truth in git;
# commit a .docx deliberately if your team writes in Word)
proposal/*.docx
# …except the course's own: the Word template pandoc lays the proposal into,
# and the worked example's output
!proposal/reference.docx
!proposal/example-proposal.docx
